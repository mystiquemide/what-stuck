# Copy to .env.local and fill in. Never commit real values.

# Public URL of the app, no trailing slash
APP_URL=http://localhost:3000

# Postgres connection string
DATABASE_URL=postgres://whatstuck:whatstuck@localhost:5432/whatstuck

# Random strings. Generate each with: openssl rand -base64 48
AUTH_SECRET=
IP_HASH_SALT=
CRON_SECRET=

# AI for the Monday report. Gemini is used when its key is set, otherwise Claude.
# The app runs without either; reports stay off.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend, for sign-in links and Wednesday notes. The app runs without it.
RESEND_API_KEY=
EMAIL_FROM="What Stuck <hello@example.com>"
