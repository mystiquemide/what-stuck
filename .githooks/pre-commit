#!/bin/sh
# Block commits that contain secrets.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so secrets can't be checked."
  echo "Install it: https://github.com/gitleaks/gitleaks#installing"
  exit 1
fi
exec gitleaks git --staged --redact --no-banner
